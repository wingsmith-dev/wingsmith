# helm package bundles everything not listed here.
*.local.yaml
*.local.yml
.env
.env.*
# The render tests run from the source tree; the package does not need them.
tests/
__pycache__/
.pytest_cache/
.DS_Store
# Anchored: a bare *.tgz also drops the subchart archives `helm dependency build` puts in charts/.
/*.tgz
