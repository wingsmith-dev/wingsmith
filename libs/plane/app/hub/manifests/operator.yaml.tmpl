---
# The enrolment token is a credential and does not ship here. Auth is stubbed: a static bearer
# token, no rotation — see docs/plans/01 §11.5. Before applying this bundle, create it out of
# band, e.g.:
#
#   kubectl create secret generic hangar-operator -n hangar-system \
#     --from-literal=enrolment-token=<real-token>
#
# 30-deployment.yaml reads it from this Secret's `enrolment-token` key. Without it, the Pod
# fails to start rather than silently dialling the hub with a placeholder credential.
apiVersion: v1
kind: ConfigMap
metadata:
  name: hangar-operator
  namespace: hangar-system
data:
  HANGAR_CLUSTER_ID: ${CLUSTER_ID}
  HANGAR_HUB_URL: ${HUB_URL}
  HANGAR_LOG_LEVEL: info
  HANGAR_LOG_FORMAT: json
  HANGAR_NAMESPACE: hangar-system
  HANGAR_HEARTBEAT_INTERVAL: 10s
  HANGAR_LIVENESS_TIMEOUT: 30s
  HANGAR_SEND_QUEUE_SIZE: "1024"
  HANGAR_LEADER_ELECTION: "true"
  # Observe and report, write nothing. This is what a cluster is pointed at a plane with the
  # first time: the reconciler is never registered and every operation is refused, so the only
  # traffic is outbound. The RBAC in rbac/role.yaml is deliberately unchanged — this is a
  # behavioural switch, not a permission one, and narrowing the role would mean two bundles to
  # keep in step. Set to "false" when the cluster should start serving what the plane declares.
  HANGAR_READ_ONLY: "true"
  # The exceptions to the line above: operation kinds a read-only operator will still perform,
  # comma-separated. Empty means none, which is what read-only meant when it was one word for
  # two guarantees — the plane does not own what runs here, and the plane may not be asked for
  # anything either. Those turned out to be separate questions: benchmarking writes to the
  # cluster, so refusing it under a blanket read-only was right, but the alternative was turning
  # on reconciliation to get it. An allowlist and not a second boolean because the kinds are not
  # interchangeable — a benchmark is additive and disposable, a drain on an unmanaged cluster is
  # not. Widen it per cluster in overlays/, never here.
  HANGAR_ALLOWED_OPERATIONS: ""
  # The in-cluster DCGM exporter, scraped for device identity only (ADR 0007). Point this at
  # whatever Service the cluster runs it under; empty disables the scrape and device ids fall
  # back to the hangar.dev/device-uuids annotation and then to <node>-gpu<index>. No RBAC is
  # needed: this is an ordinary HTTP GET to a Service DNS name, not a Kubernetes API call.
  HANGAR_DCGM_ENDPOINT: http://dcgm-exporter.platform.svc.cluster.local:9400/metrics
  HANGAR_DCGM_TIMEOUT: 5s
  # Where a benchmark aims its load: this cluster's own OpenAI-compatible frontend. It is a
  # cluster-local address by construction, and that is the point — a benchmark generates real
  # inference traffic, and rule 4 says none of that crosses the control plane. The plane names
  # the deployment and the model; how this cluster exposes its frontend is a local fact.
  # Empty: the operator finds the frontend by asking for the Service that selects Dynamo's
  # Frontend component. Set it only on a cluster whose frontend Dynamo did not label.
  HANGAR_INFERENCE_ENDPOINT: ""
  # A run that wedged against an endpoint which stopped answering would otherwise hold its
  # operation open forever. This bounds one whose request carried no deadline of its own.
  HANGAR_BENCHMARK_TIMEOUT: 30m
  # Where a run's raw per-request records go. Those are telemetry — one row per request, never
  # joined — so they belong in object storage and not in the sync stream. Left empty because
  # nothing uploads them yet: reporting a URI with nothing at it would be worse than reporting
  # none. See docs/wip.md.
  HANGAR_BENCHMARK_ARTIFACT_BASE: ""
  # What one run's load generator requests. A load generator is an HTTP client: it opens
  # connections, reads streamed tokens, and counts. No CPU limit is set anywhere, so this is a
  # scheduling floor rather than a cap and a run bursts into whatever the node has idle. Raise it
  # on a cluster where a high-concurrency run would otherwise be co-scheduled with work that
  # starves it — a generator short of CPU does not fail, it reports its own latency as the
  # engine's.
  HANGAR_BENCHMARK_CPU: 500m
  HANGAR_BENCHMARK_MEMORY: 1Gi
  # Which node pool downloads weights, and the taint it tolerates to get there. The prefetch job
  # is a network and disk job with no accelerator in it, so it belongs anywhere but a GPU node —
  # a pool of its own where one exists, and the general-purpose pool where one does not. Both are
  # here rather than left to the binary's defaults because a value that exists only in Go is one
  # nobody finds until a job sits Pending: the scheduler's answer to a pool that does not exist
  # is silence, and the deployment waiting on those weights reports only that they are not
  # resident.
  HANGAR_CACHE_POOL_VALUE: cache
  HANGAR_CACHE_TAINT_KEY: hangar.io/cache
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hangar-operator
  namespace: hangar-system
  labels:
    app.kubernetes.io/name: hangar-operator
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: hangar-operator
  template:
    metadata:
      labels:
        app.kubernetes.io/name: hangar-operator
    spec:
      serviceAccountName: hangar-operator
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: operator
          image: ${OPERATOR_IMAGE}
          imagePullPolicy: Always
          envFrom:
            - configMapRef:
                name: hangar-operator
          env:
            - name: HANGAR_ENROLMENT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: hangar-operator
                  key: enrolment-token
          ports:
            - name: health
              containerPort: 8081
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
            initialDelaySeconds: 5
            periodSeconds: 20
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
            initialDelaySeconds: 3
            periodSeconds: 10
          resources:
            requests:
              cpu: 50m
              memory: 96Mi
            limits:
              cpu: 500m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
      terminationGracePeriodSeconds: 30
---
apiVersion: v1
kind: Secret
metadata:
  name: hangar-operator
  namespace: hangar-system
type: Opaque
stringData:
  enrolment-token: "${ENROLMENT_TOKEN}"
