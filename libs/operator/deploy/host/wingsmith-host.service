# Example unit for wingsmith-host. Install the binary at /usr/local/bin/wingsmith-host, run
# `wingsmith-host enrol <token> --plane <wss://hub-url> --cluster <name>` once, then
# `systemctl enable --now wingsmith-host`.
[Unit]
Description=Wingsmith host agent
Documentation=https://github.com/wingsmith-dev/wingsmith/blob/main/docs/operations/linux-host.md
Wants=network-online.target
After=network-online.target nvidia-persistenced.service

[Service]
Type=simple
# Runs as root for the supply-only phase, by design: NVML needs the nvidia device nodes and the
# sandboxing below narrows what root can touch.
# TODO(P2.6): run as a dedicated wingsmith user in the video group.
ExecStart=/usr/local/bin/wingsmith-host run --config /etc/wingsmith/host.json
Restart=always
RestartSec=5
StateDirectory=wingsmith
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/wingsmith
# NVML and nvidia-smi open /dev/nvidia* read-write to issue ioctls; no other device access.
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidia-frontend rw
DeviceAllow=char-nvidia-uvm rw
DeviceAllow=char-nvidia-caps rw
DeviceAllow=/dev/nvidia-uvm rw

[Install]
WantedBy=multi-user.target
