# Copy to .env.local for development. Every value is optional; the defaults are shown.
# The container image ignores these and reads WINGSMITH_API_BASE_URL / WINGSMITH_READ_ONLY at
# start instead (see README.md).

# "http" talks to a plane; "fixtures" runs against the in-browser offline plane.
VITE_API_MODE=http

# Origin the browser calls for /v1. Empty means the console's own origin, which in
# development is the dev server and its proxy below.
VITE_API_BASE_URL=

# Dev server only: where /v1 and /health are forwarded. Ignored when VITE_API_BASE_URL is set.
VITE_API_PROXY=http://localhost:8000

# Start new browser sessions in read-only mode.
VITE_READ_ONLY=false
