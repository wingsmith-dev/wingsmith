#!/usr/bin/env bash
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-leaks.sh" message "$1"
# Contributions are signed off under the DCO (see CONTRIBUTING.md), and CI checks every commit of a
# pull request for it. This only warns: `git commit -s` or `git rebase --signoff` adds it.
if ! git interpret-trailers --parse "$1" | grep -qi '^Signed-off-by: '; then
  echo "commit-msg: no Signed-off-by trailer; CI's DCO check will refuse this commit (use git commit -s)" >&2
fi
